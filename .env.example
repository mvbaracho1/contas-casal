# Neon: na Vercel, a integração Neon cria DATABASE_URL (pooled) e DATABASE_URL_UNPOOLED automaticamente
DATABASE_URL="postgresql://usuario:senha@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/db?sslmode=require"
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# URL pública do app (links do e-mail de recuperação e retorno do Google).
# Na Vercel é opcional: sem ela usa o domínio de produção do projeto.
APP_URL=""

# Recuperação de senha por e-mail (https://resend.com). Sem isso, em dev o link aparece no terminal.
RESEND_API_KEY=""
EMAIL_FROM="Contas do Casal <nao-responda@seudominio.com>"

# Login com Google (console.cloud.google.com > APIs e serviços > Credenciais > ID do cliente OAuth).
# URI de redirecionamento autorizado: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
