generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Couple {
  id          String       @id @default(cuid())
  name        String
  inviteCode  String       @unique
  /// e-mail do par convidado (o convite também funciona só com o código)
  inviteEmail  String?
  inviteSentAt DateTime?
  createdAt   DateTime     @default(now())
  members     User[]
  purchases   Purchase[]
  settlements Settlement[]
  incomes     Income[]
  cards       Card[]
  bills       Bill[]
  paidMarks   PaidMark[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  /// null para quem só entra com Google
  passwordHash String?
  googleId     String?  @unique
  coupleId     String?
  couple       Couple?  @relation(fields: [coupleId], references: [id])
  createdAt    DateTime @default(now())

  paidPurchases    Purchase[]   @relation("PaidBy")
  settlementsSent  Settlement[] @relation("SettlementFrom")
  settlementsRecvd Settlement[] @relation("SettlementTo")
  incomes          Income[]
  cards            Card[]
  bills            Bill[]
  resetTokens      PasswordResetToken[]
}

/// Uma compra (à vista ou parcelada).
/// `paidById` = quem pagou / dono do cartão.
/// `payerSharePct` = quanto (%) da compra é responsabilidade de quem pagou.
///   50  -> dividida meio a meio
///   0   -> é toda do outro (ex.: esposa comprou no cartão do marido)
///   100 -> é toda de quem pagou (não gera dívida)
model Purchase {
  id            String   @id @default(cuid())
  coupleId      String
  couple        Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  description   String
  category      String?
  totalCents    Int
  installments  Int      @default(1)
  /// Mês da 1ª parcela no formato YYYY-MM (mês da fatura)
  firstMonth    String
  purchaseDate  DateTime
  paidById      String
  paidBy        User     @relation("PaidBy", fields: [paidById], references: [id])
  payerSharePct Int      @default(50)
  cardId        String?
  card          Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([coupleId, firstMonth])
}

/// Transferência feita de um para o outro para acertar as contas de um mês.
model Settlement {
  id          String   @id @default(cuid())
  coupleId    String
  couple      Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  month       String
  fromId      String
  from        User     @relation("SettlementFrom", fields: [fromId], references: [id])
  toId        String
  to          User     @relation("SettlementTo", fields: [toId], references: [id])
  amountCents Int
  note        String?
  createdAt   DateTime @default(now())

  @@index([coupleId, month])
}

/// Renda mensal de uma pessoa (salário, freela...). Vale de startMonth até endMonth (inclusive).
model Income {
  id          String   @id @default(cuid())
  coupleId    String
  couple      Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  description String
  amountCents Int
  startMonth  String
  endMonth    String?
  createdAt   DateTime @default(now())

  @@index([coupleId])
}

/// Cartão de crédito. A fatura de um mês é a soma das parcelas das compras feitas nele.
model Card {
  id         String     @id @default(cuid())
  coupleId   String
  couple     Couple     @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id])
  name       String
  color      String     @default("black")
  closingDay Int
  dueDay     Int
  limitCents Int?
  createdAt  DateTime   @default(now())
  purchases  Purchase[]
  paidMarks  PaidMark[]

  @@index([coupleId])
}

/// Conta fixa mensal (aluguel, condomínio, luz...).
/// `payerSharePct` = parte (%) de quem paga; null = proporcional à renda do casal.
model Bill {
  id            String     @id @default(cuid())
  coupleId      String
  couple        Couple     @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  name          String
  category      String     @default("Outros")
  amountCents   Int
  dueDay        Int
  paidById      String
  paidBy        User       @relation(fields: [paidById], references: [id])
  payerSharePct Int?
  startMonth    String
  endMonth      String?
  createdAt     DateTime   @default(now())
  paidMarks     PaidMark[]

  @@index([coupleId])
}

/// Marca uma conta fixa ou fatura de cartão como paga em um mês.
model PaidMark {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  month     String
  billId    String?
  bill      Bill?    @relation(fields: [billId], references: [id], onDelete: Cascade)
  cardId    String?
  card      Card?    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([billId, month])
  @@unique([cardId, month])
  @@index([coupleId, month])
}

/// Link de recuperação de senha. Guardamos só o hash do token; vale 1 hora e uma vez.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
