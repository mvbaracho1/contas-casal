generator client {
  provider        = "prisma-client-js"
  /// relationJoins: casal + membros numa consulta só (getSession)
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Couple {
  id           String       @id @default(cuid())
  name         String
  inviteCode   String       @unique
  /// e-mail do par convidado (o convite também funciona só com o código)
  inviteEmail  String?
  inviteSentAt DateTime?
  createdAt    DateTime     @default(now())
  members      User[]
  purchases    Purchase[]
  settlements  Settlement[]
  incomes      Income[]
  cards        Card[]
  bills        Bill[]
  paidMarks    PaidMark[]
  receivables  Receivable[]
  goals        Goal[]
  disputes     Dispute[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  /// null para quem só entra com Google
  passwordHash String?
  googleId     String?  @unique
  coupleId     String?
  couple       Couple?  @relation(fields: [coupleId], references: [id])
  createdAt    DateTime @default(now())

  paidPurchases    Purchase[]           @relation("PaidBy")
  settlementsSent  Settlement[]         @relation("SettlementFrom")
  settlementsRecvd Settlement[]         @relation("SettlementTo")
  incomes          Income[]
  cards            Card[]
  bills            Bill[]
  resetTokens      PasswordResetToken[]
  receivables      Receivable[]         @relation("ReceivableCreditor")
  goalEntries      GoalEntry[]
  disputesOpened   Dispute[]            @relation("DisputeOpenedBy")
  disputesResolved Dispute[]            @relation("DisputeResolvedBy")
}

/// Uma compra (à vista ou parcelada).
/// `paidById` = quem pagou / dono do cartão.
/// `payerSharePct` = quanto (%) da compra é responsabilidade de quem pagou.
///   50  -> dividida meio a meio
///   0   -> é toda do outro (ex.: esposa comprou no cartão do marido)
///   100 -> é toda de quem pagou (não gera dívida)
model Purchase {
  id               String      @id @default(cuid())
  coupleId         String
  couple           Couple      @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  description      String
  category         String?
  totalCents       Int
  installments     Int         @default(1)
  /// Parcela a partir da qual a compra entra nas contas (as anteriores foram antes do app)
  startInstallment Int         @default(1)
  /// Compra recorrente (assinatura): repete todo mês a partir de firstMonth
  recurring        Boolean     @default(false)
  /// Último mês da recorrência (YYYY-MM); null = sem fim
  endMonth         String?
  /// Mês da 1ª parcela no formato YYYY-MM (mês da fatura)
  firstMonth       String
  purchaseDate     DateTime
  paidById         String
  paidBy           User        @relation("PaidBy", fields: [paidById], references: [id])
  /// % de quem pagou; null = proporcional à renda do casal (calculado mês a mês)
  payerSharePct    Int?        @default(50)
  cardId           String?
  card             Card?       @relation(fields: [cardId], references: [id], onDelete: SetNull)
  /// Compra feita por um terceiro (amigo) no cartão: o valor a receber dele
  receivable       Receivable?
  disputes         Dispute[]
  createdAt        DateTime    @default(now())

  @@index([coupleId, firstMonth])
}

/// Transferência feita de um para o outro para acertar as contas de um mês.
model Settlement {
  id          String   @id @default(cuid())
  coupleId    String
  couple      Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  month       String
  fromId      String
  from        User     @relation("SettlementFrom", fields: [fromId], references: [id])
  toId        String
  to          User     @relation("SettlementTo", fields: [toId], references: [id])
  amountCents Int
  note        String?
  createdAt   DateTime @default(now())

  @@index([coupleId, month])
}

/// Renda mensal de uma pessoa (salário, freela...). Vale de startMonth até endMonth (inclusive).
model Income {
  id          String   @id @default(cuid())
  coupleId    String
  couple      Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  description String
  amountCents Int
  startMonth  String
  endMonth    String?
  createdAt   DateTime @default(now())

  @@index([coupleId])
}

/// Cartão de crédito. A fatura de um mês é a soma das parcelas das compras feitas nele.
model Card {
  id         String     @id @default(cuid())
  coupleId   String
  couple     Couple     @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id])
  name       String
  color      String     @default("black")
  closingDay Int
  dueDay     Int
  limitCents Int?
  createdAt  DateTime   @default(now())
  purchases  Purchase[]
  paidMarks  PaidMark[]

  @@index([coupleId])
}

/// Conta fixa mensal (aluguel, condomínio, luz...).
/// `payerSharePct` = parte (%) de quem paga; null = proporcional à renda do casal.
model Bill {
  id            String     @id @default(cuid())
  coupleId      String
  couple        Couple     @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  name          String
  category      String     @default("Outros")
  amountCents   Int
  dueDay        Int
  paidById      String
  paidBy        User       @relation(fields: [paidById], references: [id])
  payerSharePct Int?
  startMonth    String
  endMonth      String?
  createdAt     DateTime   @default(now())
  paidMarks     PaidMark[]
  disputes      Dispute[]

  @@index([coupleId])
}

/// Marca uma conta fixa ou fatura de cartão como paga em um mês.
model PaidMark {
  id        String   @id @default(cuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  month     String
  billId    String?
  bill      Bill?    @relation(fields: [billId], references: [id], onDelete: Cascade)
  cardId    String?
  card      Card?    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([billId, month])
  @@unique([cardId, month])
  @@index([coupleId, month])
}

/// Link de recuperação de senha. Guardamos só o hash do token; vale 1 hora e uma vez.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Valor a receber de um terceiro (ex.: amigo que usou o cartão). Só controle:
/// não entra no acerto entre o casal.
model Receivable {
  id               String              @id @default(cuid())
  coupleId         String
  couple           Couple              @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  /// Quem do casal recebe o dinheiro (normalmente o titular do cartão)
  creditorId       String
  creditor         User                @relation("ReceivableCreditor", fields: [creditorId], references: [id])
  personName       String
  description      String
  totalCents       Int
  installments     Int                 @default(1)
  /// Parcela a partir da qual o terceiro deve (as anteriores ficaram fora do app)
  startInstallment Int                 @default(1)
  /// Mês (YYYY-MM) em que vence a 1ª parcela
  firstMonth       String
  /// Compra ligada (fatura do cartão); os valores acompanham a compra
  purchaseId       String?             @unique
  purchase         Purchase?           @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  note             String?
  createdAt        DateTime            @default(now())
  payments         ReceivablePayment[]

  @@index([coupleId])
}

model ReceivablePayment {
  id           String     @id @default(cuid())
  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  amountCents  Int
  paidAt       DateTime
  note         String?
  createdAt    DateTime   @default(now())

  @@index([receivableId])
}

/// Meta do casal (viagem, reserva de emergência…): só controle, não entra no acerto.
model Goal {
  id          String      @id @default(cuid())
  coupleId    String
  couple      Couple      @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  name        String
  emoji       String      @default("🎯")
  targetCents Int
  /// Mês (YYYY-MM) em que querem atingir a meta; null = sem prazo
  targetMonth String?
  note        String?
  createdAt   DateTime    @default(now())
  entries     GoalEntry[]

  @@index([coupleId])
}

/// Aporte (valor positivo) ou retirada (negativo) de uma meta.
model GoalEntry {
  id          String   @id @default(cuid())
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  /// Quem guardou (ou retirou)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amountCents Int
  date        DateTime
  note        String?
  createdAt   DateTime @default(now())

  @@index([goalId])
}

/// Tentativa errada do código de acesso do cadastro (limita tentativas por IP).
model SignupCodeAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

/// Contestação de um lançamento do acerto do mês.
/// Quem deve a parte (quem não pagou) abre com uma justificativa; quem pagou aceita ou recusa.
/// Aceita: vale a divisão proposta — na compra inteira (todas as parcelas) ou na conta fixa só em `month`.
model Dispute {
  id               String    @id @default(cuid())
  coupleId         String
  couple           Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  /// "purchase" ou "bill"
  kind             String
  purchaseId       String?
  purchase         Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  billId           String?
  bill             Bill?     @relation(fields: [billId], references: [id], onDelete: Cascade)
  /// mês do acerto em que foi aberta ("YYYY-MM")
  month            String
  openedById       String
  openedBy         User      @relation("DisputeOpenedBy", fields: [openedById], references: [id])
  reason           String
  /// divisão proposta: "100" (só de quem pagou), "50" ou "renda"
  proposal         String    @default("100")
  /// "aberta" | "aceita" | "recusada"
  status           String    @default("aberta")
  response         String?
  resolvedById     String?
  resolvedBy       User?     @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt       DateTime?
  /// compra: % de quem pagou antes de aceitar (histórico)
  previousSharePct Int?
  createdAt        DateTime  @default(now())

  @@index([coupleId, month])
}
